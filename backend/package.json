{
  "name": "atmosphere-backend",
  "version": "1.0.0",
  "description": "Atmosphere backend — BFF that mediates Supabase Auth and org onboarding",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "backup": "tsx src/scripts/backup.ts snapshot",
    "backup:list": "tsx src/scripts/backup.ts list",
    "backup:verify": "tsx src/scripts/backup.ts verify",
    "backup:restore": "tsx src/scripts/backup.ts restore",
    "backup:retention": "tsx src/scripts/backup.ts retention",
    "check": "npm run typecheck && npm run check:backup && npm run check:csv",
    "check:backup": "tsx src/scripts/checkBackupArchive.ts",
    "check:csv": "tsx src/scripts/checkCsvImport.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
