{
  "name": "atmosphere-backend",
  "version": "1.0.0",
  "description": "Atmosphere backend \u2014 BFF that mediates Supabase Auth and org onboarding",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "analytics:grant": "tsx src/scripts/grantAnalyticsAccess.ts",
    "analytics:seed": "tsx src/scripts/seedAnalyticsDemo.ts",
    "lint": "eslint .",
    "test": "node --import tsx --test $(find src test -name '*.test.ts' | sort)",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "mitigation:demo": "tsx src/estimator/mitigation/demo.ts",
    "browser:install": "playwright install chromium",
    "check:verifier": "tsx src/scripts/checkVerifier.ts",
    "smoke:synthetic": "tsx scripts/smokeSyntheticPipeline.ts",
    "learn": "tsx src/scripts/learn.ts",
    "backup": "tsx src/scripts/backup.ts snapshot",
    "backup:list": "tsx src/scripts/backup.ts list",
    "backup:verify": "tsx src/scripts/backup.ts verify",
    "backup:restore": "tsx src/scripts/backup.ts restore",
    "backup:retention": "tsx src/scripts/backup.ts retention",
    "check": "npm run typecheck && npm test && npm run check:backup && npm run check:csv",
    "check:backup": "tsx src/scripts/checkBackupArchive.ts",
    "check:csv": "tsx src/scripts/checkCsvImport.ts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "stripe:sync": "tsx src/scripts/syncStripeCatalog.ts",
    "test:vitest": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@supabase/supabase-js": "^2.112.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "nodemailer": "^9.0.5",
    "playwright": "^1.62.1",
    "stripe": "^22.4.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.1",
    "globals": "^17.7.0",
    "tsx": "^4.23.11",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
