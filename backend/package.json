{
  "name": "atmosphere-backend",
  "version": "1.0.0",
  "description": "Atmosphere backend — BFF that mediates Supabase Auth and org onboarding",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "WORKER_ROLE=queue node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "analytics:grant": "tsx src/scripts/grantAnalyticsAccess.ts",
    "analytics:seed": "tsx src/scripts/seedAnalyticsDemo.ts",
    "seed:test-video": "tsx src/scripts/seedProductTestVideo.ts",
    "lint": "eslint .",
    "test": "node --import tsx --test $(find src test -name '*.test.ts' | sort)",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "smoke:synthetic": "tsx scripts/smokeSyntheticPipeline.ts",
    "check": "npm run typecheck && npm test",
    "check:migrations": "node scripts/check-migrations.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:check": "node scripts/migrate.mjs --check",
    "migrate:baseline": "node scripts/migrate.mjs --baseline",
    "migrate:dry-run": "node scripts/migrate.mjs --dry-run",
    "migrate:reconcile": "node scripts/reconcile-migrations.mjs",
    "migrate:manifest": "node scripts/migration-manifest.mjs",
    "check:email-auth": "node scripts/checkEmailAuthDns.mjs",
    "stripe:sync": "tsx src/scripts/syncStripeCatalog.ts",
    "test:vitest": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@supabase/supabase-js": "^2.116.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "nodemailer": "^9.1.1",
    "qrcode": "^1.5.4",
    "stripe": "^22.6.1",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
