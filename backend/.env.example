# ---- Atmosphere backend configuration ----
# Copy to .env and adjust. The server also has safe defaults baked in for the
# public Supabase values, so it runs without a .env in development.

# Server
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (the frontend dev server).
FRONTEND_ORIGIN=http://localhost:5173

# ---- Supabase ----
# Project URL and PUBLISHABLE (anon) key are safe to expose to browsers.
SUPABASE_URL=https://ccxatzfsvzetciiwsjlj.supabase.co
SUPABASE_ANON_KEY=sb_publishable_4ppzqtXQPeVPuzP8Ant-pQ_MZIPMcGn

# SERVICE ROLE key — SERVER-ONLY SECRET. Email/password login does not need it,
# but PIN sign-in DOES: unlocking mints a fresh session for an already-enrolled
# device, which requires admin privileges. Leave it unset and the PIN feature
# simply stays hidden — the app still works, users just always type a password.
# NEVER expose this to the browser and NEVER commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Device PIN ----
# Server-only secret mixed into every PIN hash. It must NOT live in the database
# — that separation is what stops a 4-digit PIN from being swept offline if the
# database is ever leaked. Generate with:  openssl rand -base64 48
# Required in production; development falls back to a well-known placeholder.
# Changing it invalidates every enrolled device, which is what you want if it
# is ever exposed.
# DEVICE_PEPPER=

# ---- Password reset ----
# Where the recovery email sends the user back to. Defaults to
# <FRONTEND_ORIGIN>/reset-password. This URL must ALSO be added to the Supabase
# dashboard under Authentication → URL Configuration → Redirect URLs, or the
# link in the email will be rejected.
# PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# ---- Model providers (reinforcement learning layer) ----
# See docs/reinforcement-learning.md. ALL of these are SERVER-ONLY SECRETS and
# ALL are optional: an unset key simply removes that vendor's arms from the
# routing pool. With one key set the loop still learns over prompt variants;
# with several it also learns which vendor is best at which kind of work, which
# is where most of the value is.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=

# Open-weights server (vLLM, Ollama, Together, Fireworks, OpenRouter — anything
# speaking the OpenAI /chat/completions dialect). A local server needs no key.
# This is also where a fine-tune trained on our own exported preference pairs
# would be served from; see `npm run learn -- --export <task>`.
# OSS_BASE_URL=http://localhost:8000/v1
# OSS_API_KEY=
# OSS_MODEL=llama-3.3-70b-instruct

# Override a base URL to point at a gateway, a proxy, or a regional endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
# XAI_BASE_URL=https://api.x.ai/v1

# Vendors rename and retire model ids on their own schedule. Override without a
# deploy when that happens — an id the vendor rejects takes that arm out of
# service until it is corrected.
# OPENAI_MODEL_FLAGSHIP=gpt-5
# ANTHROPIC_MODEL_BALANCED=claude-sonnet-5
# GOOGLE_MODEL_FAST=gemini-2.5-flash
# XAI_MODEL_FLAGSHIP=grok-4

# Prices in the catalog are estimates used for RELATIVE cost scoring. Correct
# them against your invoices without a deploy:
#   {"openai:flagship":{"input":1.25,"output":10}}
# AI_PRICE_OVERRIDES=

# ---- Learning loop ----
# Set to false to always serve the champion arm. Runs are still recorded and
# scored, so you accumulate the evidence that makes exploration informed before
# letting it touch real users. A sensible way to start in a new environment.
# AI_EXPLORATION_ENABLED=true

# Share of traffic spent on challenger arms. Exploration is paid for in real
# work quality, so keep it small — 10% resolves a clearly better arm in days.
# AI_CANDIDATE_TRAFFIC_SHARE=0.1

# Observations before a context slice is trusted over its broader parent.
# AI_MIN_TRIALS_PER_ARM=30

# Accepted past outputs injected as few-shot examples. Higher means stronger
# house-style matching and a bigger prompt bill.
# AI_MAX_EXEMPLARS=3

# Hard ceiling on one model call before failing over to another arm.
# AI_REQUEST_TIMEOUT_MS=60000

# ---- Backups ----
# The CRM accumulates the only record of a company's customers and jobs, so we
# keep our own copies rather than trusting a single database to never fail.
#
# Snapshots read across every organization, which needs the SERVICE ROLE key
# above. Without it, scheduled backups stay OFF and say so at boot.
# BACKUP_ENABLED=true

# Where archives go. 'local' writes to BACKUP_DIR — simple, but it only protects
# you if that volume outlives the database host. 'supabase' uploads to a private
# Storage bucket instead.
# BACKUP_DRIVER=local
# BACKUP_DIR=./backups
# BACKUP_BUCKET=atmosphere-backups

# How often to snapshot, and how long to keep finished archives.
# BACKUP_INTERVAL_MINUTES=1440
# BACKUP_RETENTION_DAYS=30

# Take a snapshot ~30s after boot. Off by default so a crash-looping process
# cannot spray half-written archives at storage on every restart.
# BACKUP_RUN_ON_BOOT=false

# AES-256-GCM key, base64, exactly 32 bytes. REQUIRED IN PRODUCTION — an archive
# holds every customer record we have, and unlike the database it gets copied to
# laptops and object stores. Generate with:  openssl rand -base64 32
# Keep the old key when you rotate, or archives written with it become unreadable.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION_KEY_ID=primary

# ---- External application mirror ----
# We run the business in other people's software. This subsystem keeps our own
# verbatim, versioned copy of that data so it survives losing vendor access.
# INTEGRATIONS_ENABLED=true
# INTEGRATION_MAX_RECORDS=50000
# INTEGRATION_TIMEOUT_MS=30000
#
# Vendor credentials are NEVER stored in the database. A source row holds only
# the NAME of a secret; the value is read from the environment as
# ATM_INTEGRATION_<NAME>. A source with credential_ref "ENCIRCLE" reads:
# ATM_INTEGRATION_ENCIRCLE=

# ---- Cookies ----
# In production behind HTTPS, cookies are automatically marked Secure.
# If the frontend and backend are on different sites, set:
#   COOKIE_SAMESITE=none   (and you MUST serve both over HTTPS)
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ---- Computer use ----
# Lets Claude see and operate computers running the Atmosphere agent. Set to
# false to remove the whole feature — API, WebSocket endpoint and all.
# COMPUTER_USE_ENABLED=true

# Optional server-wide Anthropic API key. When set, computer use works with no
# setup at all; a key connected in the UI takes priority over it. SERVER-ONLY
# SECRET — never expose it to the browser and never commit a real value.
# ANTHROPIC_API_KEY=

# Encrypts each organization's Anthropic key at rest (AES-256-GCM). Required in
# production; development falls back to a well-known placeholder. Generate with:
#   openssl rand -base64 48
# Rotating it invalidates every stored key — organizations simply re-enter one.
# AI_CREDENTIALS_KEY=
# Where those encrypted keys are written. Ciphertext only, never plaintext.
# AI_CREDENTIALS_PATH=.data/ai-credentials.json

# Signs the long-lived tokens that paired computers reconnect with. Required in
# production. Rotating it unpairs every computer, which is the correct response
# to a suspected leak. Generate with:  openssl rand -base64 48
# AGENT_TOKEN_SECRET=

# Model and screenshot defaults. Quality is economical | balanced | detailed;
# 'balanced' targets roughly 1080p, which trades accuracy against token cost
# well for most work.
# COMPUTER_USE_MODEL=claude-opus-5
# COMPUTER_USE_QUALITY=balanced

# Guard rails — a model driving a real computer can loop, so every task is
# bounded in both steps and wall-clock time.
# COMPUTER_USE_MAX_STEPS=60
# COMPUTER_USE_RUN_TIMEOUT_MS=900000
# COMPUTER_USE_ACTION_TIMEOUT_MS=45000
# COMPUTER_USE_MAX_TOKENS=16000
