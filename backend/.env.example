# ---- Atmosphere backend configuration ----
# Copy to .env and adjust. The server also has safe defaults baked in for the
# public Supabase values, so it runs without a .env in development.

# Server
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (the frontend dev server).
FRONTEND_ORIGIN=http://localhost:5173

# ---- Supabase ----
# Project URL and PUBLISHABLE (anon) key are safe to expose to browsers.
SUPABASE_URL=https://ccxatzfsvzetciiwsjlj.supabase.co
SUPABASE_ANON_KEY=sb_publishable_4ppzqtXQPeVPuzP8Ant-pQ_MZIPMcGn

# SERVICE ROLE key — SERVER-ONLY SECRET. Email/password login does not need it,
# but PIN sign-in DOES: unlocking mints a fresh session for an already-enrolled
# device, which requires admin privileges. Leave it unset and the PIN feature
# simply stays hidden — the app still works, users just always type a password.
# NEVER expose this to the browser and NEVER commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Device PIN ----
# Server-only secret mixed into every PIN hash. It must NOT live in the database
# — that separation is what stops a 4-digit PIN from being swept offline if the
# database is ever leaked. Generate with:  openssl rand -base64 48
# Required in production; development falls back to a well-known placeholder.
# Changing it invalidates every enrolled device, which is what you want if it
# is ever exposed.
# DEVICE_PEPPER=

# ---- Password reset ----
# Where the recovery email sends the user back to. Defaults to
# <FRONTEND_ORIGIN>/reset-password. This URL must ALSO be added to the Supabase
# dashboard under Authentication → URL Configuration → Redirect URLs, or the
# link in the email will be rejected.
# PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# ---- Cookies ----
# In production behind HTTPS, cookies are automatically marked Secure.
# If the frontend and backend are on different sites, set:
#   COOKIE_SAMESITE=none   (and you MUST serve both over HTTPS)
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ---- Project Manager Agent ----
# Server-only secret for the writing layer (morning briefs, drafted customer and
# adjuster updates). OPTIONAL: without it the brief is still generated from the
# same facts using a deterministic template, and every other part of the agent —
# the rules, the alerts, the generated work — behaves identically.
# NEVER expose this to the browser and NEVER commit a real value.
# ANTHROPIC_API_KEY=

# Which model writes. Prices are NOT set here: public.model_rate_card in the
# database is the source of truth, and metering goes through record_usage.
# PM_MODEL=claude-opus-5

# The background automation pass. OFF by default, deliberately: a timer has no
# user session, so it runs with the service-role key and bypasses RLS — the one
# place in this feature that does. On-demand runs (every page load, and the
# "re-check" button) need no such privilege and work with this unset.
# Requires SUPABASE_SERVICE_ROLE_KEY as well; with either missing it will not start.
# PM_SCHEDULER_ENABLED=false
# PM_SCHEDULER_INTERVAL_MINUTES=30
