# ---- Atmosphere backend configuration ----
# Copy to .env and adjust. The server also has safe defaults baked in for the
# public Supabase values, so it runs without a .env in development.

# Server
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (the frontend dev server).
FRONTEND_ORIGIN=http://localhost:5173

# ---- Supabase ----
# Project URL and PUBLISHABLE (anon) key are safe to expose to browsers.
SUPABASE_URL=https://ccxatzfsvzetciiwsjlj.supabase.co
SUPABASE_ANON_KEY=sb_publishable_4ppzqtXQPeVPuzP8Ant-pQ_MZIPMcGn

# SERVICE ROLE key — SERVER-ONLY SECRET. Email/password login does not need it,
# but PIN sign-in DOES: unlocking mints a fresh session for an already-enrolled
# device, which requires admin privileges. Leave it unset and the PIN feature
# simply stays hidden — the app still works, users just always type a password.
# NEVER expose this to the browser and NEVER commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Device PIN ----
# Server-only secret mixed into every PIN hash. It must NOT live in the database
# — that separation is what stops a 4-digit PIN from being swept offline if the
# database is ever leaked. Generate with:  openssl rand -base64 48
# Required in production; development falls back to a well-known placeholder.
# Changing it invalidates every enrolled device, which is what you want if it
# is ever exposed.
# DEVICE_PEPPER=

# ---- Password reset ----
# Where the recovery email sends the user back to. Defaults to
# <FRONTEND_ORIGIN>/reset-password. This URL must ALSO be added to the Supabase
# dashboard under Authentication → URL Configuration → Redirect URLs, or the
# link in the email will be rejected.
# PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# ---- Construction Estimator ----
# The estimator signs in to DocuSketch, Dash, and Xactimate on behalf of an
# organization, so it necessarily holds real vendor credentials.

# SERVER-ONLY SECRET. AES-256-GCM key that encrypts every stored vendor
# credential before it reaches Postgres. It must NOT live in the database —
# that separation is what makes a database leak yield ciphertext and nothing
# else. Generate with:  openssl rand -base64 32
# Without it, credentials cannot be stored and only sandbox mode works.
# ESTIMATOR_CREDENTIAL_KEY=

# Reads damage off field photos and scope directions out of CRM job notes.
# Optional: leave it unset and the estimator still runs, building scope from the
# scan measurements and the mitigation estimate, and saying so in the run log.
# ANTHROPIC_API_KEY=
# ESTIMATOR_MODEL=claude-opus-5
# low | medium | high | xhigh | max — raise it if photo findings come back thin.
# ESTIMATOR_EFFORT=medium

# `sandbox` serves built-in fixtures so the whole pipeline can be exercised with
# no vendor account; `live` talks to the real APIs. Defaults to sandbox in
# development and live in production, so a deploy cannot silently serve fixtures.
# ESTIMATOR_CONNECTOR_MODE=sandbox

# Vendor API roots. Every integrator's tenant is somewhere different (regional
# hosts, on-prem Dash, Xactimate vs XactAnalysis), so there is no useful default
# — an unset host makes that connector report itself unconfigured rather than
# guessing. An organization can override any of these alongside its credentials.
# DOCUSKETCH_BASE_URL=
# DASH_BASE_URL=
# XACTIMATE_BASE_URL=

# Cost and throughput controls for the photo-reading stage. Each full-resolution
# photo costs roughly 5k input tokens, so the per-run cap is the main lever.
# ESTIMATOR_MAX_PHOTOS=40
# ESTIMATOR_PHOTO_CONCURRENCY=4
# ESTIMATOR_REQUEST_TIMEOUT_MS=30000
# ESTIMATOR_MAX_RETRIES=3

# ---- Cookies ----
# In production behind HTTPS, cookies are automatically marked Secure.
# If the frontend and backend are on different sites, set:
#   COOKIE_SAMESITE=none   (and you MUST serve both over HTTPS)
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
