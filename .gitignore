# Dependencies
node_modules/

# Vite cache (website dev server)
website/.vite/
# Written by deploy-website.yml so Railway retries actually rebuild.
website/.railway-up-stamp
frontend/.railway-up-stamp
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets — never commit real secrets
.env
.env.local
.env.*.local
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Coverage / test
coverage/
.nyc_output/

# Vite
frontend/dist/
frontend/dist-ssr/
*.local

# Never commit database backups — they contain auth credentials/PII
recovery/
*backup*.json

# Playwright smoke-test screenshots
frontend/.smoke/

# Backup archives. Encrypted at rest when a key is configured, but they still
# hold every customer record we have — they never belong in version control.
backups/
backend/backups/
*.atmbak

# Encrypted Anthropic API keys written by the backend at runtime.
# The contents are ciphertext, but there is no reason to version them.
backend/.data/

# Development invite / OTP mail sink (SYSTEM_MAIL_DRIVER=log)
backend/.mail/
