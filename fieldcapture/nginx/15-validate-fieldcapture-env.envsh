#!/bin/sh
# vim:sw=2:ts=2:sts=2:et
#
# Sourced by the nginx image entrypoint before 20-envsubst-on-templates.sh.
# .envsh, not .sh: only a sourced file can export PORT / API_UPSTREAM /
# API_RESOLVERS to envsubst. Never exit: the entrypoint runs with set -e.
#
# Same repair as the office console: an unresolved Railway reference becomes
# "http://:" and would take this replica down. Fall back to the public BFF
# so name + office-code connect still works.

fieldcapture_log() { echo "fieldcapture: $*" >&2; }

fieldcapture_public_bff="https://atmosphere-production.up.railway.app"
fieldcapture_default_api_port="4000"

case "${PORT:-}" in
  '' | *[!0-9]*)
    fieldcapture_log "PORT='${PORT:-}' is not a port number — binding 8080."
    PORT=8080
    ;;
esac
export PORT

fieldcapture_upstream="$(printf '%s' "${API_UPSTREAM:-}" | tr -d ' \t\n\r' || true)"
fieldcapture_upstream="${fieldcapture_upstream%/}"
fieldcapture_usable=''

case "$fieldcapture_upstream" in
  '')
    fieldcapture_log 'API_UPSTREAM is unset.'
    ;;
  *'${{'* | *'}}'*)
    fieldcapture_log "API_UPSTREAM='${fieldcapture_upstream}' still holds an unresolved Railway reference."
    ;;
  http://:* | https://:*)
    fieldcapture_log "API_UPSTREAM='${fieldcapture_upstream}' has no host — check the service name"
    fieldcapture_log 'in the reference (the BFF service is "Atmosphere APIs").'
    ;;
  http://*: | https://*:)
    fieldcapture_usable="${fieldcapture_upstream}${fieldcapture_default_api_port}"
    fieldcapture_log "API_UPSTREAM='${fieldcapture_upstream}' has no port — using ${fieldcapture_usable}."
    ;;
  http://127.0.0.1* | http://localhost* | 'http://[::1]'*)
    if [ -n "${RAILWAY_ENVIRONMENT:-}${RAILWAY_PRIVATE_DOMAIN:-}" ]; then
      fieldcapture_log "API_UPSTREAM='${fieldcapture_upstream}' is loopback inside this container."
    else
      fieldcapture_usable="$fieldcapture_upstream"
    fi
    ;;
  http://* | https://*)
    fieldcapture_usable="$fieldcapture_upstream"
    ;;
  *)
    fieldcapture_log "API_UPSTREAM='${fieldcapture_upstream}' is not an http(s) URL."
    ;;
esac

if [ -z "$fieldcapture_usable" ]; then
  fieldcapture_usable="$fieldcapture_public_bff"
  fieldcapture_log "serving /api from ${fieldcapture_usable} so this replica still starts."
  fieldcapture_log 'Set API_UPSTREAM on this service to the Atmosphere APIs private'
  fieldcapture_log 'HTTP URL to keep /api inside the mesh (see docs/production.md).'
fi

API_UPSTREAM="$fieldcapture_usable"
export API_UPSTREAM

fieldcapture_resolvers="$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' /etc/resolv.conf 2>/dev/null || true)"
fieldcapture_resolvers="${fieldcapture_resolvers% }"
[ -n "$fieldcapture_resolvers" ] || fieldcapture_resolvers="127.0.0.11"
API_RESOLVERS="${NGINX_RESOLVERS:-$fieldcapture_resolvers}"
export API_RESOLVERS

fieldcapture_log "listening on ${PORT}, proxying /api to ${API_UPSTREAM} via resolver ${API_RESOLVERS}"

unset fieldcapture_upstream fieldcapture_usable fieldcapture_resolvers fieldcapture_public_bff fieldcapture_default_api_port
