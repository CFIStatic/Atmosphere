# Field Capture web host. PORT, API_UPSTREAM, and API_RESOLVERS are
# substituted at container start (NGINX_ENVSUBST_FILTER). Every other $var
# is nginx's own.
#
# Crews open this origin, type a name + office join code, and the page POSTs
# /api/field-app/join. That must reach the Atmosphere BFF — a static-only
# nginx answers POST with 405 HTML, which the app surfaces as "Request failed."

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 25m;
  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # Liveness for this replica only — never proxied. A cold or misconfigured
  # BFF must not fail Railway's probe: the connect screen is static files and
  # only /api needs the API.
  location = /healthz {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location = /health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location = /api/health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location /api {
    resolver ${API_RESOLVERS} valid=10s ipv6=on;
    resolver_timeout 5s;
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_intercept_errors on;
    error_page 502 503 504 = @api_down;
  }

  location @api_down {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header Content-Type "application/json; charset=utf-8" always;
    return 503 '{"error":"Atmosphere API is not reachable. Set API_UPSTREAM on this service to the Atmosphere APIs private HTTP URL.","code":"backend_unreachable"}';
  }

  location / {
    add_header Cache-Control "no-store";
    try_files $uri $uri/ /index.html;
  }
}
