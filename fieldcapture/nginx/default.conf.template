# Field Capture only — no office login, no dashboard.
# PORT, API_UPSTREAM, and API_RESOLVERS are substituted at container start
# (NGINX_ENVSUBST_FILTER). Every other $var is nginx's own.

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 25m;
  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

  # Liveness for this replica only — never proxied. A cold BFF must not fail
  # Railway's probe: the phone app is static files and only /api needs the API.
  location = /healthz {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location = /health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location = /api/health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location /api {
    resolver ${API_RESOLVERS} valid=10s ipv6=on;
    resolver_timeout 5s;
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_intercept_errors on;
    error_page 502 503 504 = @api_down;
  }

  location @api_down {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header Content-Type "application/json; charset=utf-8" always;
    return 503 '{"error":"Atmosphere API is not reachable. Set API_UPSTREAM on Field Capture to the Atmosphere APIs private HTTP URL.","code":"backend_unreachable"}';
  }

  location /js/ {
    add_header Cache-Control "no-store";
    try_files $uri =404;
  }

  location /icons/ {
    add_header Cache-Control "public, max-age=86400";
    try_files $uri =404;
  }

  # Existing invite links use /fieldcapture/?token= on the office host.
  # This dedicated host serves the same path so those links keep working
  # when the origin is swapped, and also serves the app at /.
  location /fieldcapture/ {
    add_header Cache-Control "no-store";
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    try_files $uri $uri/ /fieldcapture/index.html;
  }

  location / {
    add_header Cache-Control "no-store";
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    try_files $uri $uri/ /index.html;
  }
}
