# Only substitute Railway/runtime knobs (${PORT}, ${API_UPSTREAM}).
# Leave nginx's own $uri / $host / $http_upgrade alone.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  # Same listen form as the office + staff nginx images. Binding only
  # 0.0.0.0 left IPv6 replicas unreachable to Railway's healthcheck.
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Platform probes must never proxy to the BFF. A hung API_UPSTREAM is what
  # turned GitHub Autodeploy into "Deployment failed during network process".
  location = /health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok\n';
  }

  location = /healthz {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok\n';
  }

  location = /api/health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok\n';
  }

  # Query-string cache-bust (?v=…) on HTML means these can be immutable again.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location ~* \.html$ {
    add_header Cache-Control "no-store";
    try_files $uri =404;
  }

  # Careers / contact forms post to the BFF. Same-origin so the static host
  # does not need a baked-in data-api origin.
  location /api/ {
    # Proxy through a variable, not a literal host: nginx resolves a literal
    # proxy_pass host at startup and refuses to start when it is not in DNS,
    # which would take the marketing pages down with a redeploying BFF.
    resolver ${API_RESOLVERS} valid=10s ipv6=on;
    resolver_timeout 5s;
    set $api_upstream ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    # $request_uri, because a variable proxy_pass passes no URI of its own.
    proxy_pass $api_upstream$request_uri;
  }

  location / {
    add_header Cache-Control "no-store";
    try_files $uri $uri/ =404;
  }
}
