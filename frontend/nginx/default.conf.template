# Office console + Field Capture + Verifier.
# PORT and API_UPSTREAM are substituted at container start
# (office-start.sh / NGINX_ENVSUBST_FILTER). Every other $var is nginx's own.

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 25m;
  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  # Verifier is iframed by the office shell on the same origin.
  add_header X-Frame-Options SAMEORIGIN always;

  # Platform probes must never proxy to the BFF. A hung or empty API_UPSTREAM
  # is what turned Login & Dashboard deploys into Network > Healthcheck failure.
  location = /healthz {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location = /health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location = /api/health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location /api {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location /verifier/ {
    try_files $uri $uri/ /verifier/index.html;
  }

  # Chrome / iOS will not treat Field Capture as an installable app if the
  # manifest is served as application/octet-stream (nginx's default).
  location ~* \.webmanifest$ {
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff always;
  }

  location = /fieldcapture/sw.js {
    add_header Cache-Control "no-cache";
    add_header Service-Worker-Allowed "/fieldcapture/";
    add_header X-Content-Type-Options nosniff always;
  }

  location /fieldcapture/ {
    try_files $uri $uri/ /fieldcapture/index.html;
  }

  location / {
    add_header Cache-Control "no-store";
    try_files $uri $uri/ /index.html;
  }
}
