# Office console + Field Capture + Verifier.
# PORT and API_UPSTREAM are substituted at container start
# (NGINX_ENVSUBST_FILTER). Every other $var is nginx's own.

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 25m;
  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  # Office HTML is iframed by Field Capture's 480px web frame. CSP
  # frame-ancestors allows the live Field Capture host and Railway hosts,
  # not every tenant.
  add_header Content-Security-Policy "frame-ancestors 'self' https://app.atmosphereteam.com https://www.app.atmosphereteam.com https://field-capture.up.railway.app https://field-capture-production.up.railway.app https://field-capture-staging.up.railway.app" always;

  # Liveness for this replica only — never proxied. A cold or misconfigured
  # BFF must not fail Railway's probe: the console, /login included, is static
  # files and only /api needs the API. /health and /api/health are answered
  # here too, so a service still resolving the repo-root railway.toml (which
  # probes /api/health) passes on this image as well.
  location = /healthz {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location = /health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location = /api/health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok';
  }

  location /api {
    # Proxy through a variable, not a literal host. nginx resolves a literal
    # proxy_pass host once at startup and refuses to start when it is not in
    # DNS ("host not found in upstream"), so a BFF that is mid-redeploy would
    # take this console down with it. A variable defers that to request time,
    # where a miss is a 502 the @api_down block turns into JSON.
    resolver ${API_RESOLVERS} valid=10s ipv6=on;
    resolver_timeout 5s;
    set $api_upstream ${API_UPSTREAM};
    # $request_uri, because a variable proxy_pass passes no URI of its own.
    proxy_pass $api_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    # An unreachable BFF answers as JSON the SPA can render, not an nginx
    # error page the fetch layer reports as "Unexpected token '<'".
    proxy_intercept_errors on;
    error_page 502 503 504 = @api_down;
  }

  location @api_down {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header Content-Type "application/json; charset=utf-8" always;
    return 503 '{"error":"Atmosphere API is not reachable. Set API_UPSTREAM on this service to the Atmosphere APIs private HTTP URL.","code":"backend_unreachable"}';
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location /verifier/ {
    add_header Cache-Control "no-store";
    add_header Content-Security-Policy "frame-ancestors 'self' https://app.atmosphereteam.com https://www.app.atmosphereteam.com https://field-capture.up.railway.app https://field-capture-production.up.railway.app https://field-capture-staging.up.railway.app" always;
    try_files $uri $uri/ /verifier/index.html;
  }

  location /fieldcapture/ {
    add_header Cache-Control "no-store";
    add_header Content-Security-Policy "frame-ancestors 'self' https://app.atmosphereteam.com https://www.app.atmosphereteam.com https://field-capture.up.railway.app https://field-capture-production.up.railway.app https://field-capture-staging.up.railway.app" always;
    try_files $uri $uri/ /fieldcapture/index.html;
  }

  # Direct /index.html and the PWA start URL must never keep a stale script
  # tag that still names an old /assets/index-*.js (the hashed files
  # themselves stay immutable below).
  location = /index.html {
    add_header Cache-Control "no-store";
    add_header Content-Security-Policy "frame-ancestors 'self' https://app.atmosphereteam.com https://www.app.atmosphereteam.com https://field-capture.up.railway.app https://field-capture-production.up.railway.app https://field-capture-staging.up.railway.app" always;
  }

  location = /manifest.webmanifest {
    add_header Cache-Control "no-store";
  }

  location / {
    add_header Cache-Control "no-store";
    add_header Content-Security-Policy "frame-ancestors 'self' https://app.atmosphereteam.com https://www.app.atmosphereteam.com https://field-capture.up.railway.app https://field-capture-production.up.railway.app https://field-capture-staging.up.railway.app" always;
    try_files $uri $uri/ /index.html;
  }
}
