# Office console + Field Capture + Verifier.
# PORT, API_UPSTREAM, and NGINX_RESOLVER are substituted at container start
# (office-start.sh / NGINX_ENVSUBST_FILTER). Every other $var is nginx's own.

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 25m;
  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  # Verifier is iframed by the office shell on the same origin.
  add_header X-Frame-Options SAMEORIGIN always;

  # Platform probes must never proxy to the BFF. A hung API_UPSTREAM is what
  # turned Login & Dashboard CLI deploys into "Healthcheck failure" after 60s.
  location = /healthz {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok\n';
  }

  location = /health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok\n';
  }

  # Leftover Railway probes that still hit /api/health (the BFF path). Keep
  # this replica up even when the mesh is cold; Sign in uses /api/auth/login.
  location = /api/health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    return 200 'ok\n';
  }

  location /api {
    # Re-resolve on each request. A static proxy_pass caches the BFF's
    # private IP at start; Railway rotates that IP on every Atmosphere APIs
    # deploy, and getaddrinfo prefers IPv4 which 504s on this IPv6 mesh.
    # Sign in then shows "Cannot reach the Atmosphere API" while the public
    # https://atmosphere-production.up.railway.app host is healthy.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    resolver_timeout 2s;
    set $api_upstream "${API_UPSTREAM}";
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_intercept_errors on;
    error_page 502 503 504 = @api_down;
  }

  location @api_down {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header Content-Type "application/json; charset=utf-8" always;
    return 503 '{"error":"Cannot reach the Atmosphere API right now. Wait a moment and try again.","code":"backend_unreachable"}';
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location /verifier/ {
    try_files $uri $uri/ /verifier/index.html;
  }

  location /fieldcapture/ {
    try_files $uri $uri/ /fieldcapture/index.html;
  }

  location / {
    add_header Cache-Control "no-store";
    try_files $uri $uri/ /index.html;
  }
}
