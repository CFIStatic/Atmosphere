# Office console + Field Capture + Verifier.
# PORT and API_UPSTREAM are substituted at container start
# (NGINX_ENVSUBST_FILTER). Every other $var is nginx's own.

# Share / guest URLs carry tokens. Stamp noindex even when try_files
# internally redirects to /index.html (location-scoped add_header is lost
# on that redirect unless the fallback location also emits the tag).
map $request_uri $share_robots_tag {
  default "";
  ~*^/progress(?:-view)?(?:/|\?|$) "noindex, nofollow, noarchive";
  ~*^/shared(?:/|\?|$) "noindex, nofollow, noarchive";
  ~*^/verifier/shared(?:/|\?|$) "noindex, nofollow, noarchive";
}

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 25m;
  gzip on;
  # nginx defaults to level 1. Level 6 sends the Dashboard (Verifier HTML,
  # ~450 KB raw) as 109 KB instead of 136 KB, and the app's JS about 15%
  # smaller, for a few ms of CPU per response.
  gzip_comp_level 6;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

  # HSTS + CSP live in security-headers.conf. Every location that sets its
  # own add_header must include that file again — nginx does not inherit
  # add_header into those blocks. frame-ancestors stays limited to the
  # Field Capture hosts that iframe this office.
  include /etc/nginx/security-headers.conf;

  # Liveness for this replica only — never proxied. A cold or misconfigured
  # BFF must not fail Railway's probe: the console, /login included, is static
  # files and only /api needs the API. /health and /api/health are answered
  # here too, so a service still resolving the repo-root railway.toml (which
  # probes /api/health) passes on this image as well.
  location = /healthz {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    include /etc/nginx/security-headers.conf;
    return 200 'ok';
  }

  location = /health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    include /etc/nginx/security-headers.conf;
    return 200 'ok';
  }

  location = /api/health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    include /etc/nginx/security-headers.conf;
    return 200 'ok';
  }

  location /api {
    # Proxy through a variable, not a literal host. nginx resolves a literal
    # proxy_pass host once at startup and refuses to start when it is not in
    # DNS ("host not found in upstream"), so a BFF that is mid-redeploy would
    # take this console down with it. A variable defers that to request time,
    # where a miss is a 502 the @api_down block turns into JSON.
    resolver ${API_RESOLVERS} valid=10s ipv6=on;
    resolver_timeout 5s;
    set $api_upstream ${API_UPSTREAM};
    # $request_uri, because a variable proxy_pass passes no URI of its own.
    proxy_pass $api_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    # Relay the X-Real-IP Railway's public edge set (it overwrites any caller copy
    # and, behind Cloudflare, fills it from CF-Connecting-IP). $remote_addr here
    # is Railway's internal hop, not the visitor.
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Connection "";
    # The API's response headers (helmet, CORS, and on a silent token refresh
    # two clear + two new session cookies) can pass nginx's default 4k header
    # buffer. nginx then answers 503 "upstream sent too big header" and the
    # page shows no videos. Seen on the shared job's Videos (/proof) poll.
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    # An unreachable BFF answers as JSON the SPA can render, not an nginx
    # error page the fetch layer reports as "Unexpected token '<'".
    proxy_intercept_errors on;
    error_page 502 503 504 = @api_down;
  }

  location @api_down {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header Content-Type "application/json; charset=utf-8" always;
    include /etc/nginx/security-headers.conf;
    return 503 '{"error":"Atmosphere API is not reachable. Set API_UPSTREAM on this service to the Atmosphere APIs private HTTP URL.","code":"backend_unreachable"}';
  }

  # Favicons / touch icons. Links carry ?v=N, so a day of caching is safe
  # and a bumped version still lands immediately.
  location ^~ /icons/ {
    add_header Cache-Control "public, max-age=86400";
    include /etc/nginx/security-headers.conf;
    try_files $uri =404;
  }

  # Hashed, so immutable. A missing file is a real 404, never index.html:
  # an HTML fallback here would be parsed as JS and fail confusingly.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    include /etc/nginx/security-headers.conf;
    try_files $uri =404;
  }

  # Share / guest surfaces must not be indexed: tokens in the path are
  # credentials. X-Robots-Tag covers crawlers that never run SPA JS.
  location ^~ /progress {
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }

  location ^~ /progress-view {
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }

  location ^~ /shared {
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }

  location ^~ /verifier/shared {
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /verifier/index.html;
  }

  # Verifier HTML is one un-hashed file: the browser may keep it but must
  # revalidate (ETag) every time, so a deploy is picked up on the next load
  # and an unchanged page costs a 304 instead of ~100 KB.
  location /verifier/ {
    add_header Cache-Control "no-cache";
    add_header X-Robots-Tag $share_robots_tag always;
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /verifier/index.html;
  }

  location /fieldcapture/ {
    add_header Cache-Control "no-store";
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /fieldcapture/index.html;
  }

  # Direct /index.html and the PWA start URL must never keep a stale script
  # tag that still names an old /assets/index-*.js (the hashed files
  # themselves stay immutable below).
  location = /index.html {
    add_header Cache-Control "no-store";
    add_header X-Robots-Tag $share_robots_tag always;
    include /etc/nginx/security-headers.conf;
  }

  # Build id the open app polls to notice a new deploy, and the list of
  # hashed files the next image build carries forward. Never cached.
  location = /version.json {
    add_header Cache-Control "no-store";
    include /etc/nginx/security-headers.conf;
    try_files $uri =404;
  }

  location = /assets-manifest.json {
    add_header Cache-Control "no-store";
    include /etc/nginx/security-headers.conf;
    try_files $uri =404;
  }

  location = /manifest.webmanifest {
    add_header Cache-Control "no-store";
    include /etc/nginx/security-headers.conf;
  }

  location / {
    add_header Cache-Control "no-store";
    add_header X-Robots-Tag $share_robots_tag always;
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }
}
